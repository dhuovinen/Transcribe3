# Copy this file to .env and fill in values as needed.
# No values are required for Phase 1 (transcript cleaning + manual speaker ID).

# Optional: override the default sessions storage directory
# TRANSCRIBE3_SESSIONS_DIR=./sessions

# Optional: override where the app-level settings.json lives (LLM providers,
# defaults, thresholds — edited via the gear-icon Settings screen). Kept
# separate from TRANSCRIBE3_SESSIONS_DIR since it isn't session-specific.
# TRANSCRIBE3_CONFIG_DIR=./config

# Registered local ports:
# API: http://localhost:8010
# UI:  http://localhost:3015
#
# Optional LAN browser origin(s), as a comma-separated allowlist. Keep this
# unset for local-only use. Example for a host at 192.168.1.50:
# TRANSCRIBE3_CORS_ORIGINS=http://192.168.1.50:3015
# For the React UI, copy src/ui/.env.example to src/ui/.env.local if you need
# to override the default API URL.

# Required for Phase 2 (audio diarization via pyannote.audio)
# Get a free token at https://huggingface.co/settings/tokens
# Then accept model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
# HF_TOKEN=hf_...

# Optional: bearer token for an LLM provider that requires authentication.
# The variable name is TRANSCRIBE3_LLM_API_KEY_<PROVIDER_ID>, where <PROVIDER_ID>
# is the provider's id in Settings, uppercased with non-alphanumerics as "_".
# The provider with id "olmx" therefore reads:
# TRANSCRIBE3_LLM_API_KEY_OLMX=sk-...
# The token is sent as "Authorization: Bearer <token>" on both the model-list and
# completion calls. To read an existing variable instead, set "api_key_env" on
# that provider's entry in config/settings.json to its name.
# Restart the API server after changing this — .env is read at startup only.
