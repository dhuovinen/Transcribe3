      "end_time": 0.0,
      "speaker": {
        "anonymous_id": "MORGAN_CHEN",
        "resolved_name": "Morgan Chen"
      },
      "text": "It's humbling, really. Though I sometimes worry that the nuances get lost in translation.",
      "confidence": 0.95,
      "flags": []
